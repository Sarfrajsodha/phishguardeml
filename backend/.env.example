# Environment Configuration for PhishGuard AI Phishing Detector

# ── Flask Configuration ────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-jwt-in-production
PORT=5000

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default) - path relative to backend/
DATABASE_URL=sqlite:///phishing_detector.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/phishing_detector

# ── CORS Configuration ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=*

# For production, use specific domains:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
# Format: YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# IMPORTANT: This is for frontend. Backend does NOT need the Client Secret for
# token verification (it uses Google's public keys). Client Secret is only for
# server-to-server API calls if needed in the future.

# ── ML Models ──────────────────────────────────────────────────────────────────
# Models are trained with: python ml/train.py
# And stored in: backend/ml/models/

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Format: "limit per period" (e.g., "100 per hour")
# Default: 100 per hour
